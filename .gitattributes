# Normalize line endings: always store as LF in git, checkout as LF on all OSes.
# This prevents CRLF from breaking shell scripts when developing on Windows/WSL.
* text=auto eol=lf

# Explicitly enforce LF for scripts and config files
*.sh   text eol=lf
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.env* text eol=lf
*.txt  text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
*.html text eol=lf
*.css  text eol=lf

# Treat binary files as binary (never modify line endings)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mid  binary
*.midi binary
*.pkl  binary
